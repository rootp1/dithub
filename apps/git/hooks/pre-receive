#!/usr/bin/env bun
// Asks the Dithub API whether the pusher may update each ref (permissions, branch protection).
// Fast-forward detection happens here: during pre-receive the new objects live in git's quarantine
// directory, which only this process can see.
const ZERO = /^0+$/
const updates = await Promise.all((await Bun.stdin.text()).split('\n').filter(Boolean).map(async (line) => {
  const [oldOid, newOid, ref] = line.split(' ') as [string, string, string]
  let ff = true
  if (!ZERO.test(oldOid!) && !ZERO.test(newOid!)) {
    ff = (await Bun.spawn(['git', 'merge-base', '--is-ancestor', oldOid, newOid], { stdout: 'ignore', stderr: 'ignore' }).exited) === 0
  }
  return { oldOid, newOid, ref, ff }
}))
const res = await fetch(`${process.env.DHEET_INTERNAL_URL}/internal/pre-receive`, {
  method: 'POST',
  headers: { 'content-type': 'application/json', authorization: `Bearer ${process.env.DHEET_INTERNAL_TOKEN}` },
  body: JSON.stringify({ repoId: process.env.DHEET_REPO_ID, userId: process.env.DHEET_USER_ID, updates }),
}).catch((e) => { console.error(`dithub: policy service unreachable: ${e}`); return null })
if (!res) process.exit(1)
if (!res.ok) { console.error(`dithub: push rejected: ${(await res.text()).trim()}`); process.exit(1) }
