# Copy to infra/.env.bee on the server (gitignored, never commit). Read only by the bee service.
# Encrypts the node's keystore in the beedata volume
BEE_PASSWORD=change-me
# Sepolia RPC with unpruned eth_getLogs (Bee replays postage history from the contract start block).
# Alchemy free tier and publicnode do not work; https://sepolia.gateway.tenderly.co does.
BEE_BLOCKCHAIN_RPC_ENDPOINT=https://sepolia.gateway.tenderly.co
