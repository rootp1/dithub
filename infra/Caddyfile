{$SITE_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	request_body {
		max_size 512MB
	}
	reverse_proxy api:3000 {
		flush_interval -1
		transport http {
			response_header_timeout 10m
		}
	}
}
