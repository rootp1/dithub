# Canonical site. Wallet sign-in (SIWE) is bound to this host and cookies are per host, so every other name redirects here.
{$SITE_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	request_body {
		max_size 512MB
	}
	reverse_proxy api:3000 {
		flush_interval -1
		transport http {
			response_header_timeout 10m
		}
	}
}

# Old and alternate names (e.g. www, the original sslip.io address) keep working by redirecting to the canonical host.
{$REDIRECT_HOSTS:www.dithub.app} {
	redir https://{$SITE_HOST}{uri} permanent
}
