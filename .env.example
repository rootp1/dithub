ARKIV_ACCESS_KEY=
DHEET_PRIVATE_KEY=
DHEET_SEAT_KEY=
DHEET_STRANGER_KEY=
DHEET_LINODE_API_KEY=
CRE_ETH_PRIVATE_KEY=
DHEET_DEPLOYER_KEY=
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=
ZG_API_KEY=
ZG_PRIVATE_KEY=
ZG_PRIVY_APP_ID=

# Optional public repository recovery via Swarm. Set all three on API and worker.
# Bee upload API must be private and use a funded postage batch; never expose it to browsers.
SWARM_BEE_URL=
SWARM_BATCH_ID=
# Independent reader exposing GET /bytes/<reference>, used for full retrieval checks.
SWARM_READ_URL=
# Per-bundle upload/download cap, in bytes (default 10 GiB).
SWARM_MAX_BYTES=10737418240
# CLI/API trusted relayer override for self-hosted instances (API can derive it from DHEET_PRIVATE_KEY).
DHEET_RECOVERY_WRITER=
