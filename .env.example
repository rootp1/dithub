ARKIV_ACCESS_KEY=
DHEET_PRIVATE_KEY=
DHEET_SEAT_KEY=
DHEET_STRANGER_KEY=
DHEET_LINODE_API_KEY=
CRE_ETH_PRIVATE_KEY=
DHEET_DEPLOYER_KEY=
SEPOLIA_RPC_URL=
L1_NETWORK=sepolia
L1_RPC_URL=
BASE_RPC_URL=
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=
ZG_API_KEY=
ZG_PRIVATE_KEY=
ZG_PRIVY_APP_ID=
# App runtime (api + worker share these)
# One SQLite file shared by api and worker; empty = <repo>/.data/dithub.sqlite (production: /data/db/dithub.sqlite)
DATABASE_PATH=
# >= 32 random bytes (openssl rand -hex 32); required in production
SESSION_SECRET=
# Server's X25519 private key, 32-byte hex (openssl rand -hex 32); the server is a member of every private repo.
# It is also the secret behind opaque private-repo ids on Arkiv/L1: never change it once private repos are published
DITHUB_DEVICE_KEY=
INTERNAL_TOKEN=
# Swarm (Bee). Unset BEE_URL disables Swarm; reads and recovery need only BEE_URL, uploads also need a batch id
BEE_URL=http://127.0.0.1:1633
# 64-hex postage batch id (dev: `make stamp`)
BEE_POSTAGE_BATCH_ID=
# Optional: 1 = ask Bee to pin uploads locally; largest repo (bytes) the worker uploads to Swarm
BEE_PIN=
SWARM_MAX_BYTES=500000000
